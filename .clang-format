# https://google.github.io/styleguide/cppguide.html
BasedOnStyle: Google
Language: Cpp
Standard: c++17
DerivePointerAlignment: false
PointerAlignment: Left
# Google style, but with tabs like the rest of the code
UseTab: Always
TabWidth: 4
IndentWidth: 4
ContinuationIndentWidth: 4
ConstructorInitializerIndentWidth: 4
AccessModifierOffset: -4
BreakConstructorInitializers: AfterColon
# related header, C headers (SDL counts), C++ std, other libs, then ours
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^<.*\.h>'
    Priority: 1
  - Regex: '^<[a-z_]+>'
    Priority: 2
  - Regex: '^<.*'
    Priority: 3
  - Regex: '.*'
    Priority: 4
